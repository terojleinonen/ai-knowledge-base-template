#!/usr/bin/env python3
"""End-to-end check of the deployed demo.

Usage: bin/check-demo --api https://<service>.onrender.com --web https://<project>.pages.dev [--ask]

With Turnstile enabled on the API, set DEMO_MONITOR_TOKEN (= the API's KB_MONITOR_TOKEN).

Without --ask it costs no LLM credit: an off-topic question exercises embeddings, the
database and the chat endpoint, but is filtered out before the chat model is called. A tiny
upload is stored, indexed, re-indexed from storage and deleted (one small embedding call).
--ask also asks one real question (one chat model call).
Exits non-zero if any check fails.
"""

import argparse
import ipaddress
import json
import os
import re
import sys
import time
import urllib.error
import urllib.request
import uuid

USER_AGENT = "kb-demo-check/1.0 (+https://github.com/terojleinonen/ai-knowledge-base-template)"

failures = []


def request(method, url, body=None, headers=None, timeout=60):
    # Cloudflare blocks Python's default "Python-urllib" user agent with a 403.
    headers = {"Accept": "application/json", "User-Agent": USER_AGENT, **(headers or {})}
    data = None
    if body is not None:
        data = json.dumps(body).encode()
        headers["Content-Type"] = "application/json"
    req = urllib.request.Request(url, data=data, headers=headers, method=method)
    try:
        with urllib.request.urlopen(req, timeout=timeout) as res:
            return res.status, dict(res.headers), res.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, dict(e.headers), e.read().decode(errors="replace")


def upload(url, filename, text, headers):
    boundary = uuid.uuid4().hex
    body = (f'--{boundary}\r\nContent-Disposition: form-data; name="file"; filename="{filename}"\r\n'
            f'Content-Type: text/plain\r\n\r\n{text}\r\n--{boundary}--\r\n').encode()
    req = urllib.request.Request(url, data=body, method="POST", headers={
        "Accept": "application/json", "User-Agent": USER_AGENT,
        "Content-Type": f"multipart/form-data; boundary={boundary}", **headers,
    })
    try:
        with urllib.request.urlopen(req, timeout=60) as res:
            return res.status, res.read().decode()
    except urllib.error.HTTPError as e:
        return e.code, e.read().decode(errors="replace")


def wait_for_ready(api, document_id, auth, timeout=120):
    started = time.time()
    while time.time() - started < timeout:
        status, _, body = request("GET", f"{api}/api/documents/{document_id}", headers=auth)
        doc = json.loads(body).get("data", {}) if status == 200 else {}
        if doc.get("status") in ("ready", "failed"):
            return doc
        time.sleep(3)
    return {"status": "timeout"}


def check(name, ok, detail=""):
    print(f"{'✓' if ok else '✗'} {name}" + (f": {detail}" if detail else ""), flush=True)
    if not ok:
        failures.append(name)
    return ok


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--api", required=True)
    parser.add_argument("--web", required=True)
    parser.add_argument("--ask", action="store_true", help="also ask one real question (one chat model call)")
    args = parser.parse_args()
    api, web = args.api.rstrip("/"), args.web.rstrip("/")

    # 1. Wake the API (free hosting sleeps when idle).
    started = time.time()
    status = None
    while time.time() - started < 180:
        try:
            status, headers, _ = request("GET", f"{api}/up", timeout=30)
        except OSError:
            status, headers = None, {}
        routing = {k.lower(): v for k, v in headers.items()}.get("x-render-routing", "")
        if status == 200 or "suspend" in routing:
            break
        time.sleep(5)
    if not check("API is up", status == 200, f"HTTP {status} after {time.time() - started:.0f}s" + (f" ({routing})" if routing else "")):
        return

    # 2. Public settings.
    status, _, body = request("GET", f"{api}/api/config")
    config = json.loads(body) if status == 200 else {}
    check("demo mode enabled", config.get("demo") is True, body[:120])

    # 3. Frontend serves the app and points at this API.
    status, _, html = request("GET", f"{web}/", headers={"Accept": "text/html"})
    check("frontend loads", status == 200, f"HTTP {status}")
    bundle = re.search(r'/assets/index-[^"]+\.js', html)
    js = request("GET", f"{web}{bundle.group(0)}", headers={"Accept": "*/*"})[2] if bundle else ""
    check("frontend uses this API", f"{api}/api" in js)

    # 4. Browsers on the frontend's origin may call the API.
    status, headers, _ = request("OPTIONS", f"{api}/api/auth/guest", headers={
        "Origin": web, "Access-Control-Request-Method": "POST", "Access-Control-Request-Headers": "content-type,authorization",
    })
    allowed = {k.lower(): v for k, v in headers.items()}.get("access-control-allow-origin")
    check("CORS allows the frontend", allowed == web, f"allow-origin: {allowed}")

    # 4b. Per-visitor limits need the visitor's real IP, not the proxy's (e.g. ::1 or 10.x).
    status, _, body = request("GET", f"{api}/api/client-ip")
    seen = json.loads(body).get("ip", "") if status == 200 else ""
    try:
        public = ipaddress.ip_address(seen).is_global
    except ValueError:
        public = False
    check("API sees visitors' real IPs", public, f"sees {seen or body[:80]}")

    # 5. Guest session with the sample documents.
    # With Turnstile enabled, automated checks identify themselves with the monitor token.
    monitor = {"X-Monitor-Token": os.environ["DEMO_MONITOR_TOKEN"]} if os.environ.get("DEMO_MONITOR_TOKEN") else {}
    status, _, body = request("POST", f"{api}/api/auth/guest", headers={"Origin": web, **monitor})
    token = json.loads(body).get("token") if status == 201 else None
    if not check("guest session created", bool(token), f"HTTP {status}"):
        return
    auth = {"Authorization": f"Bearer {token}", "Origin": web}

    status, _, body = request("GET", f"{api}/api/documents", headers=auth)
    docs = json.loads(body).get("data", []) if status == 200 else []
    ready = [d["title"] for d in docs if d["status"] == "ready"]
    check("sample documents ready", len(docs) > 0 and len(ready) == len(docs), f"{len(ready)}/{len(docs)} ready")

    # 5b. Upload round trip: store, index, re-index from storage (proves the file is still
    # there, e.g. on R2 across restarts), delete. One tiny embedding call.
    marker = uuid.uuid4().hex[:8]
    status, body = upload(f"{api}/api/documents", f"check-{marker}.txt",
                          f"Demo check {marker}: the storage round trip works and this note is temporary.", auth)
    document_id = json.loads(body).get("data", {}).get("id") if status == 201 else None
    if check("upload accepted", bool(document_id), f"HTTP {status}" + (f": {body[:160]}" if status != 201 else "")):
        doc = wait_for_ready(api, document_id, auth)
        check("upload indexed", doc.get("status") == "ready", f"status {doc.get('status')}: {doc.get('error') or ''}".strip(": "))

        status, _, body = request("POST", f"{api}/api/documents/{document_id}/reprocess", headers=auth)
        doc = wait_for_ready(api, document_id, auth) if status == 200 else {"status": f"HTTP {status}"}
        check("stored file re-read for re-indexing", doc.get("status") == "ready",
              f"status {doc.get('status')}: {doc.get('error') or ''}".strip(": "))

        status, _, _ = request("DELETE", f"{api}/api/documents/{document_id}", headers=auth)
        check("upload deleted", status == 204, f"HTTP {status}")

    # 6. Search pipeline (embeddings + database), filtered out before the chat model.
    status, _, body = request("POST", f"{api}/api/chat", {"question": "Who won the 2022 football World Cup?"}, auth, timeout=90)
    answer = json.loads(body).get("data", {}) if status == 201 else {}
    check("search pipeline works", status == 201 and answer.get("sources") == [], f"HTTP {status}: {body[:160]}" if status != 201 else "")

    # 7. Optional: one real question through the chat model.
    if args.ask:
        status, _, body = request("POST", f"{api}/api/chat",
                                  {"question": "How many vacation days do employees get per year?"}, auth, timeout=120)
        answer = json.loads(body).get("data", {}) if status == 201 else {}
        content = answer.get("content", "")
        check("chat model answers with a citation",
              status == 201 and "30" in content and "[" in content and len(answer.get("sources", [])) > 0,
              f"HTTP {status}: {(content or body)[:160]}")


if __name__ == "__main__":
    main()
    if failures:
        print(f"\n{len(failures)} check(s) failed: {', '.join(failures)}")
        sys.exit(1)
    print("\nAll checks passed.")
