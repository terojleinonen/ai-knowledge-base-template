#!/usr/bin/env bash
# First-time local setup: dependencies, env files, database.
set -euo pipefail
cd "$(dirname "$0")/.."

command -v php >/dev/null || { echo "PHP 8.3+ is required"; exit 1; }
command -v composer >/dev/null || { echo "Composer is required (https://getcomposer.org)"; exit 1; }
command -v npm >/dev/null || { echo "Node.js 20+ is required"; exit 1; }

for ext in iconv mbstring zip pdo_sqlite; do
  php -r "exit(extension_loaded('$ext') ? 0 : 1);" || { echo "✗ PHP extension '$ext' is missing (MacPorts: sudo port install php83-$ext)"; exit 1; }
done

echo "→ Backend"
(
  cd backend
  composer install --no-interaction
  [ -f .env ] || { cp .env.example .env; php artisan key:generate --no-interaction; }
  [ -f database/database.sqlite ] || touch database/database.sqlite
  php artisan migrate --no-interaction
)

echo "→ Frontend"
(
  cd frontend
  npm install
  [ -f .env ] || cp .env.example .env
)

echo "✓ Done. Add an AI provider key to backend/.env (or configure Ollama), then run: bin/dev"
