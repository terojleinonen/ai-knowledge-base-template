<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="sqlite"/>
        <env name="DB_DATABASE" value=":memory:"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="KB_CHAT_PROVIDER" value="openai" force="true"/>
        <env name="KB_CHAT_MODEL" value="gpt-4o-mini" force="true"/>
        <env name="KB_EMBEDDINGS_PROVIDER" value="openai" force="true"/>
        <env name="KB_EMBEDDINGS_MODEL" value="text-embedding-3-small" force="true"/>
        <env name="KB_EMBEDDINGS_DIMENSIONS" value="" force="true"/>
        <env name="KB_EMBEDDINGS_QUERY_PREFIX" value="" force="true"/>
        <env name="KB_EMBEDDINGS_DOCUMENT_PREFIX" value="" force="true"/>
        <env name="KB_CHUNK_SIZE" value="1200" force="true"/>
        <env name="KB_CHUNK_OVERLAP" value="200" force="true"/>
        <env name="KB_RETRIEVAL_TOP_K" value="6" force="true"/>
        <env name="KB_RETRIEVAL_MIN_SCORE" value="0.2" force="true"/>
        <env name="KB_RETRIEVAL_MODE" value="hybrid" force="true"/>
        <env name="KB_RERANK_PROVIDER" value="" force="true"/>
        <env name="KB_RERANK_MIN_SCORE" value="" force="true"/>
        <env name="KB_HISTORY_MESSAGES" value="6" force="true"/>
        <env name="KB_CITATION_REPAIR" value="true" force="true"/>
        <env name="KB_DEMO_ENABLED" value="false" force="true"/>
        <env name="KB_REGISTRATION_ENABLED" value="true" force="true"/>
        <env name="KB_LIMIT_QUESTIONS_PER_USER" value="" force="true"/>
        <env name="KB_LIMIT_QUESTIONS_PER_DAY" value="" force="true"/>
        <env name="KB_LIMIT_DOCUMENTS_PER_USER" value="" force="true"/>
        <env name="KB_LIMIT_QUESTIONS_PER_IP" value="" force="true"/>
        <env name="KB_LIMIT_GUESTS_PER_DAY" value="" force="true"/>
        <env name="KB_LIMIT_GUESTS_PER_IP_PER_HOUR" value="" force="true"/>
        <env name="KB_LIMIT_CHUNKS_PER_USER" value="" force="true"/>
        <env name="KB_LIMIT_STORAGE_MB" value="" force="true"/>
        <env name="KB_CLIENT_IP_HEADER" value="" force="true"/>
        <env name="TRUSTED_PROXIES" value="" force="true"/>
        <env name="KB_UPLOAD_DISK" value="local" force="true"/>
        <env name="R2_BUCKET" value="" force="true"/>
        <env name="KB_TURNSTILE_SITE_KEY" value="" force="true"/>
        <env name="KB_TURNSTILE_SECRET_KEY" value="" force="true"/>
        <env name="KB_MONITOR_TOKEN" value="" force="true"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
