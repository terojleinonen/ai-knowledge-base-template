APP_NAME="Knowledge Base"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false


# Comma-separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- AI -------------------------------------------------------------------
# Providers are defined in config/ai.php (openai, anthropic, ollama, gemini, ...).
# Fully local & free: install Ollama, then
#   ollama pull nomic-embed-text && ollama pull qwen2.5:3b
# and set both providers below to "ollama".
KB_CHAT_PROVIDER=openai
KB_CHAT_MODEL=gpt-6-luna
# Anthropic only: effort (claude-opus-5-5 defaults to medium) and server-side refusal fallbacks.
# KB_CHAT_EFFORT=medium
# KB_CHAT_FALLBACKS=default
KB_EMBEDDINGS_PROVIDER=openai
KB_EMBEDDINGS_MODEL=text-embedding-3-small
# KB_EMBEDDINGS_DIMENSIONS=

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# --- Knowledge base tuning --------------------------------------------------
KB_UPLOAD_MAX_KB=20480
KB_CHUNK_SIZE=1200
KB_CHUNK_OVERLAP=200
KB_RETRIEVAL_TOP_K=6
KB_RETRIEVAL_MIN_SCORE=0.2
# hybrid = vector + BM25 keyword search; vector = embeddings only
KB_RETRIEVAL_MODE=hybrid

# Optional reranker (jina, cohere, voyageai). Jina's 10M free tokens cover roughly 3,000 questions.
# KB_RERANK_PROVIDER=jina
# KB_RERANK_MODEL=jina-reranker-v2-base-multilingual
# JINA_API_KEY=
# Drop passages scored below this (unset = reorder only; calibrate with kb:eval).
# KB_RERANK_MIN_SCORE=0.12

# API token lifetime in minutes (default 30 days).
# SANCTUM_TOKEN_EXPIRATION=43200
